# Copy to .env.local for local dev. Paste the same keys into Vercel
# project settings -> Environment Variables (Production + Preview).
#
# Find these in your Supabase project at:
#   https://supabase.com/dashboard/project/_/settings/api

# Public client config (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only: bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Random secret for the daily keep-alive cron. Generate with:
#   openssl rand -base64 32
# Without it the route runs unauthenticated.
CRON_SECRET=your-random-string
